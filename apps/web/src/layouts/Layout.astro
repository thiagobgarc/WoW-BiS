---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  accentColor?: string;
  ogImage?: string;
}

const {
  title = 'Mythos — WoW Best-in-Slot Gear Planner',
  description = 'Look up your character and see exactly what to upgrade, where it drops, and how close you are to Best-in-Slot.',
  accentColor,
  ogImage,
} = Astro.props;
---

<html lang="en" style={accentColor ? `--accent: ${accentColor};` : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Archivo variable, both axes: width 62–125 and weight 100–900. One
         family does display, UI and figures; the width axis replaces the
         second typeface a design like this would normally reach for. -->
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-bg text-text font-sans flex flex-col">
    <!-- Neutral, not accent: a class-colored fill fails AA against both white
         and dark text on 10 of the 13 classes. See global.css. -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:top-4 focus:left-4 focus:px-4 focus:py-2 focus:rounded focus:bg-text focus:text-bg focus:font-semibold focus:no-underline"
    >
      Skip to content
    </a>
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <footer class="mt-20 border-t border-rule">
      <p class="mx-auto max-w-5xl px-6 py-7 text-xs leading-relaxed text-text-dim">
        Not affiliated with or endorsed by Blizzard Entertainment. World of Warcraft and all related assets are the
        property of Blizzard Entertainment, Inc. No game assets are rehosted — icons and media are loaded directly
        from Blizzard's API.
      </p>
    </footer>
  </body>
</html>
