---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  accentColor?: string;
  ogImage?: string;
  /** Path for rel=canonical when the request path isn't the preferred spelling (e.g. case-insensitive routes). */
  canonicalPath?: string;
  /** Keep the page out of search indexes — error states, mock data. */
  noindex?: boolean;
  /** schema.org objects, each emitted as its own JSON-LD block. */
  jsonLd?: Record<string, unknown>[];
}

const {
  title = 'WoW BiS Gear Planner — See Every Upgrade Left | Mythos',
  description = 'Look up your World of Warcraft character and see exactly what to upgrade, where each Best-in-Slot item drops, and how close you are to BiS.',
  accentColor,
  ogImage,
  canonicalPath = Astro.url.pathname,
  noindex = false,
  jsonLd = [],
} = Astro.props;

// Astro.site comes from SITE_URL / Vercel's production host (astro.config.mjs),
// so preview deployments still point canonicals at production.
const origin = Astro.site ?? Astro.url.origin;
const canonical = new URL(canonicalPath, origin).toString();
// "<" escaped so item or character names can never close the script tag.
const ldJson = (data: Record<string, unknown>) => JSON.stringify(data).replace(/</g, '\\u003c');
---

<html lang="en" style={accentColor ? `--accent: ${accentColor};` : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#121113" />

    <meta property="og:site_name" content="Mythos" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    {jsonLd.map((data) => <script is:inline type="application/ld+json" set:html={ldJson(data)} />)}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Archivo variable, both axes: width 62–125 and weight 100–900. One
         family does display, UI and figures; the width axis replaces the
         second typeface a design like this would normally reach for. -->
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-bg text-text font-sans flex flex-col">
    <!-- Neutral, not accent: a class-colored fill fails AA against both white
         and dark text on 10 of the 13 classes. See global.css. -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:top-4 focus:left-4 focus:px-4 focus:py-2 focus:rounded focus:bg-text focus:text-bg focus:font-semibold focus:no-underline"
    >
      Skip to content
    </a>
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <footer class="mt-20 border-t border-rule">
      <p class="mx-auto max-w-5xl px-6 py-7 text-xs leading-relaxed text-text-dim">
        Not affiliated with or endorsed by Blizzard Entertainment. World of Warcraft and all related assets are the
        property of Blizzard Entertainment, Inc. No game assets are rehosted — icons and media are loaded directly
        from Blizzard's API.
      </p>
    </footer>
  </body>
</html>
