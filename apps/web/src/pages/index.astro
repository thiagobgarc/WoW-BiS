---
import Layout from '@/layouts/Layout.astro';
import SiteHeader from '@/components/layout/SiteHeader.astro';
import { SearchForm } from '@/components/search/SearchForm';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Mythos',
    url: new URL('/', Astro.site ?? Astro.url.origin).toString(),
    description: 'World of Warcraft Best-in-Slot gear planner and spec meta tier lists.',
  },
];
---

<Layout jsonLd={jsonLd}>
  <SiteHeader currentPath={Astro.url.pathname} />

  <div class="mx-auto max-w-5xl px-6">
    <!-- The spine. It runs the length of the page's content on every screen:
         here in the brand default, on a character page in that character's
         class color. Left-aligned throughout, so the headline, the name
         field and every recent row share one axis. -->
    <div class="my-14 border-l-[3px] border-accent pl-6 sm:my-20 sm:pl-10">
      <h1 class="display max-w-[20ch] text-[clamp(2.5rem,7.5vw,4rem)]">Every slot you can still upgrade.</h1>
      <p class="mt-6 max-w-[58ch] text-base leading-relaxed text-text-muted">
        Look up a character and Mythos lines up what they're wearing against the best-in-slot list for their
        spec — slot by slot, with where each replacement drops.
      </p>

      <div class="mt-10">
        <SearchForm client:load />
      </div>

      <p class="mt-10 flex flex-wrap gap-x-6 gap-y-2 text-sm text-text-muted">
        <span>Or browse without a character:</span>
        <a href="/bis" class="link font-medium text-text">BiS gear for every spec</a>
        <a href="/meta" class="link font-medium text-text">Mythic+ and raid tier list</a>
      </p>
    </div>
  </div>
</Layout>
