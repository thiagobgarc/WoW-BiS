# Blizzard Battle.net API (OAuth2 client credentials). Get these at
# https://develop.battle.net/access/clients. Leave unset to run the whole
# app against // MOCK: fixture data with zero external setup.
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
# Region used for the OAuth token endpoint itself (us | eu | kr | tw | cn).
# Character lookups can target any region regardless of this value.
BLIZZARD_OAUTH_REGION=us

# Upstash Redis (REST API, not the TCP endpoint). Leave unset to use the
# in-memory cache fallback — fine for local dev, not for multi-instance prod.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Postgres connection string (Neon/Supabase-compatible), used for the BiS
# data layer from Phase 3 onward.
DATABASE_URL=
